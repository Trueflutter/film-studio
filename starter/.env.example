# Copy to .env and fill in only what you use. Never commit .env or paste keys into chat.

# ByteDance ModelArk / BytePlus (Seedance direct, incl. Seedance 2.5 Draft Mode)
ARK_API_KEY=
# Optional: override the endpoint for your region (default: BytePlus international)
# ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3

# fal.ai (hundreds of image/video/audio models)
FAL_KEY=

# EvoLink (aggregator)
EVOLINK_API_KEY=

# ElevenLabs (voices, speech-to-speech, sound effects, transcription for captions)
ELEVENLABS_API_KEY=
